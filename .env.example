NODE_ENV=production
TZ=Asia/Shanghai
HOST=0.0.0.0
PORT=4173
APP_ORIGIN=http://服务器IP:4173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/workbench.db
GENERATION_BATCH_LIMIT=5
GENERATION_COOLDOWN_MINUTES=60
GENERATION_TARGET_DEFAULT=700
GENERATION_RETRY_MINUTES=5
INBOX_SYNC_INTERVAL_SECONDS=30
INBOX_SYNC_CONCURRENCY=2
PUBLIC_MAIL_RATE_LIMIT=60
LOG_LEVEL=info
PYTHON_COMMAND=python
PYTHON_BRIDGE=./python/hme_bridge.py

# 统一邮箱池 API：默认关闭，新增配置不替换现有密钥或数据库。
MAIL_API_ENABLED=false
MAIL_API_TOKEN=
# 独立 HTTPS 入口；本机可用 http://127.0.0.1:4173，留空回退 APP_ORIGIN。
MAIL_API_ORIGIN=
# 指定已有可收件账号及与 freeAgent 不重叠的标签前缀。
MAIL_API_ACCOUNT_ID=
MAIL_API_LABEL_PREFIX=
